# ==========================================
# BENJINEER PORTFOLIO - ENVIRONMENT VARIABLES
# ==========================================

# 1. APP CONFIGURATION
NEXT_PUBLIC_APP_NAME="Benjineer Portfolio"
NEXT_PUBLIC_ENVIRONMENT="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 2. SANITY CMS
NEXT_PUBLIC_SANITY_PROJECT_ID="..."
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"
SANITY_REVALIDATE_SECRET="sec_..."

# AGENT TOKENS
SANITY_AGENT_RUNNER_TOKEN="skc..."
SANITY_AGENT_READ_ONLY_TOKEN="skc..."

# 3. CONTACT FORM & EMAIL DISPATCH (Resend)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="..."
RESEND_TO_EMAIL="..."

# 4. BOT SPAM PROTECTION (Google reCAPTCHA v3)
RECAPTCHA_SECRET_KEY="6Lc..."
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6Lc..."

# 5. AGENTIC BLOGGING: PHASE 1 WEBHOOK GATEKEEPER
# Shared secret configured in GitHub Webhook settings across tracked repositories
GITHUB_WEBHOOK_SECRET="your_shared_webhook_secret_here"

# Fine-grained GitHub Personal Access Token (PAT) with "Actions: Read and Write" on portfolio repo
GIT_REPO_PAT_TOKEN="github_pat_..." # specific repo pat
GIT_PAT_ORGANIZATION="github_pat_..." # org repo pat

# Portfolio repository coordinates where autonomous-devlog.yml workflow resides
PORTFOLIO_REPO_OWNER="BenjiBenji20"
PORTFOLIO_REPO_NAME="portfolio"

